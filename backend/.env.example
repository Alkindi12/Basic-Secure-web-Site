# Copy this file to .env and fill in the values:  cp .env.example .env
# .env is ignored by git. Never commit real secrets.

# REQUIRED. A long random value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

NODE_ENV=development
PORT=5000
# Interface to listen on. Keep 127.0.0.1 unless a reverse proxy on another host needs it.
HOST=127.0.0.1

# Origins allowed to call the API with cookies (comma separated).
CORS_ORIGINS=http://localhost:5173

# Demo accounts + sample data for learners (npm run seed). Refused when NODE_ENV=production.
DEMO_MODE=true

# Optional
# DB_PATH=./data/tourly.sqlite
# STORAGE_DIR=./storage/trips
# SESSION_IDLE_MINUTES=30
# SESSION_ABSOLUTE_HOURS=8
# BCRYPT_COST=12
# TRUST_PROXY=1          # set when running behind a reverse proxy (HTTPS termination)
